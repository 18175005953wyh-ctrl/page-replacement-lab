if(NOT DEFINED APP OR NOT DEFINED SOURCE OR NOT DEFINED WORK)
    message(FATAL_ERROR "APP SOURCE WORK required")
endif()
file(MAKE_DIRECTORY "${WORK}")
set(passed 0)
set(trace "${SOURCE}/data/belady.trace")

function(run_case name expected_exit pattern)
    execute_process(COMMAND "${APP}" ${ARGN} WORKING_DIRECTORY "${WORK}"
        OUTPUT_VARIABLE output ERROR_VARIABLE errors RESULT_VARIABLE status TIMEOUT 20)
    if(NOT "${status}" STREQUAL "${expected_exit}")
        message(FATAL_ERROR "${name}: exit ${status}, expected ${expected_exit}\n${output}\n${errors}")
    endif()
    if(NOT "${output}\n${errors}" MATCHES "${pattern}")
        message(FATAL_ERROR "${name}: missing pattern ${pattern}\n${output}\n${errors}")
    endif()
    math(EXPR next "${passed} + 1")
    set(passed ${next} PARENT_SCOPE)
    set(last_output "${output}" PARENT_SCOPE)
    message(STATUS "[PASS] ${name}")
endfunction()

run_case("FIFO classic three frames" 0 "FIFO +12 +3 +9 +6 +75.00%" --trace "${trace}" --frames 3 --policy fifo)
set(fifo_output "${last_output}")
run_case("default FIFO" 0 "FIFO +12 +3 +9 +6 +75.00%" --frames 3 --trace "${trace}")
if(NOT last_output STREQUAL fifo_output)
    message(FATAL_ERROR "Default policy output differs from explicit FIFO")
endif()
if(last_output MATCHES "Step|Frames\\n|\\[1")
    message(FATAL_ERROR "Nonverbose output contains per-step records")
endif()
run_case("FIFO four frames" 0 "FIFO +12 +2 +10 +6 +83.33%" --trace "${trace}" --frames 4 --policy fifo)
run_case("LRU three frames" 0 "LRU +12 +2 +10 +7 +83.33%" --trace "${trace}" --frames 3 --policy lru)
run_case("OPT three frames" 0 "OPT +12 +5 +7 +4 +58.33%" --trace "${trace}" --frames 3 --policy opt)
run_case("compare bound" 0 "OPT bound: verified" --trace "${trace}" --frames 3 --compare)
foreach(policy FIFO LRU OPT)
    if(NOT last_output MATCHES "${policy} +12")
        message(FATAL_ERROR "Comparison missing ${policy}")
    endif()
endforeach()
set(first_compare "${last_output}")
run_case("repeat comparison deterministic" 0 "OPT bound: verified" --trace "${trace}" --frames 3 --compare)
if(NOT last_output STREQUAL first_compare)
    message(FATAL_ERROR "Repeated comparison differs")
endif()
run_case("verbose frame snapshots" 0 "\\[4 1 3\\]" --trace "${trace}" --frames 3 --policy fifo --verbose)
if(NOT last_output MATCHES "Step +Page +Result +Evicted +Frames" OR NOT last_output MATCHES "HIT")
    message(FATAL_ERROR "Verbose header/hits missing")
endif()
run_case("verbose comparison labels" 0 "OPT steps" --verbose --compare --frames 3 --trace "${trace}")
if(NOT last_output MATCHES "FIFO steps" OR NOT last_output MATCHES "LRU steps")
    message(FATAL_ERROR "Comparison verbose labels missing")
endif()
run_case("Belady detects three to four" 0 "FIFO faults increased from 9 to 10 when frames increased from 3 to 4" --trace "${trace}" --belady 2 6)
if(NOT last_output MATCHES "LRU and OPT curves: non-increasing")
    message(FATAL_ERROR "Stack algorithm verification missing")
endif()
run_case("single-frame range" 0 "No FIFO Belady anomaly detected" --trace "${trace}" --belady 3 3)
run_case("1024 frames" 0 "FIFO +12 +7 +5 +0" --trace "${trace}" --frames 1024)
run_case("max Belady bound" 0 "1024 +5 +5 +5" --trace "${trace}" --belady 1024 1024)
run_case("empty comparison rate" 0 "N/A" --trace "${SOURCE}/data/empty.trace" --frames 3 --compare)
if(last_output MATCHES "nan|inf%")
    message(FATAL_ERROR "Empty trace produced invalid ratio")
endif()
run_case("empty Belady scan" 0 "No FIFO Belady anomaly detected" --trace "${SOURCE}/data/empty.trace" --belady 1 5)
file(MAKE_DIRECTORY "${WORK}/path with spaces")
configure_file("${trace}" "${WORK}/path with spaces/test.trace" COPYONLY)
run_case("trace path with spaces" 0 "FIFO +12" --trace "${WORK}/path with spaces/test.trace" --frames 3)
file(WRITE "${WORK}/extremes.trace" "0\n4294967295\n0\n")
run_case("uint32 page extremes verbose" 0 "4294967295" --trace "${WORK}/extremes.trace" --frames 2 --policy opt --verbose)
run_case("missing file" 1 "Cannot open trace" --trace "${WORK}/missing.trace" --frames 3)
file(WRITE "${WORK}/bad.trace" "# header\n\n1\n-2\n3\n")
run_case("bad trace physical line and no simulation" 1 "line 4:" --trace "${WORK}/bad.trace" --frames 3 --verbose)
if(NOT last_output STREQUAL "")
    message(FATAL_ERROR "Invalid trace produced partial simulation output")
endif()
string(REPEAT "0" 300 long_line)
file(WRITE "${WORK}/long.trace" "1\n${long_line}\n")
run_case("overlong trace" 1 "line 2: line too long" --trace "${WORK}/long.trace" --frames 3)

foreach(value 0 -1 1025 abc 1.5 0x10 +3 999999999999999999999999999)
    run_case("invalid frames ${value}" 1 "Invalid arguments" --trace "${trace}" --frames "${value}")
endforeach()
run_case("no arguments" 1 "Usage:")
run_case("no trace option" 1 "Invalid arguments" --frames 3)
run_case("no frame option" 1 "Invalid arguments" --trace "${trace}")
run_case("unknown option" 1 "Invalid arguments" --trace "${trace}" --frames 3 --unknown)
run_case("unknown policy" 1 "Invalid arguments" --trace "${trace}" --frames 3 --policy random)
run_case("uppercase policy" 1 "Invalid arguments" --trace "${trace}" --frames 3 --policy FIFO)
run_case("policy compare conflict" 1 "Invalid arguments" --trace "${trace}" --frames 3 --policy fifo --compare)
run_case("Belady frames conflict" 1 "Invalid arguments" --trace "${trace}" --belady 2 6 --frames 3)
run_case("Belady policy conflict" 1 "Invalid arguments" --trace "${trace}" --belady 2 6 --policy fifo)
run_case("Belady verbose conflict" 1 "Invalid arguments" --trace "${trace}" --belady 2 6 --verbose)
run_case("Belady compare conflict" 1 "Invalid arguments" --trace "${trace}" --belady 2 6 --compare)
run_case("reversed range" 1 "Invalid arguments" --trace "${trace}" --belady 6 2)
run_case("range zero" 1 "Invalid arguments" --trace "${trace}" --belady 0 6)
run_case("range too large" 1 "Invalid arguments" --trace "${trace}" --belady 2 1025)
run_case("duplicate trace" 1 "Invalid arguments" --trace "${trace}" --trace "${trace}" --frames 3)
run_case("duplicate frames" 1 "Invalid arguments" --trace "${trace}" --frames 3 --frames 3)
run_case("duplicate policy" 1 "Invalid arguments" --trace "${trace}" --frames 3 --policy fifo --policy lru)
run_case("duplicate verbose" 1 "Invalid arguments" --trace "${trace}" --frames 3 --verbose --verbose)
run_case("duplicate compare" 1 "Invalid arguments" --trace "${trace}" --frames 3 --compare --compare)
run_case("duplicate Belady" 1 "Invalid arguments" --trace "${trace}" --belady 2 6 --belady 2 6)
run_case("trace missing value" 1 "Invalid arguments" --trace)
run_case("frames missing value" 1 "Invalid arguments" --trace "${trace}" --frames)
run_case("policy missing value" 1 "Invalid arguments" --trace "${trace}" --frames 3 --policy)
run_case("Belady missing max" 1 "Invalid arguments" --trace "${trace}" --belady 2)
run_case("option used as value" 1 "Invalid arguments" --trace --frames 3)
run_case("help alone" 0 "Usage:" --help)
run_case("help combined rejected" 1 "Invalid arguments" --help --trace "${trace}" --frames 3)
message(STATUS "${passed} CLI cases passed")
